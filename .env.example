# Hugging Face token — required for speaker diarization (pyannote)
HF_TOKEN=your_huggingface_token_here

# LLM backends for AI-assisted coding (set the one(s) you use; server picks them up on restart)
# OpenAI:
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Anthropic (Claude):
# ANTHROPIC_API_KEY=sk-ant-...
# Local Ollama needs no key — just run `ollama serve` (OLLAMA_HOST defaults to http://127.0.0.1:11434)

# Registration domain allow-list for the team server (comma-separated)
# ALLOWED_EMAIL_DOMAINS=ait.ac.at

# --- Production (full guide: deploy/README.md) ---
# Use PostgreSQL instead of the default SQLite (needs: pip install -e ".[server,postgres]")
# DATABASE_URL=postgresql+psycopg://tcuser:PASSWORD@127.0.0.1:5432/tcdb
# Behind HTTPS, give the session cookie the Secure flag:
# COOKIE_SECURE=1
