# ── transkript::studio — production environment ───────────────────────────────
# Copy to deploy/.env (for Docker) and/or to the repo-root .env (for the native
# Windows app). NEVER commit the filled-in file. Both are gitignored.

# --- Database (PostgreSQL) ---------------------------------------------------
# Docker Compose reads these to create the DB container:
POSTGRES_USER=tcuser
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=tcdb

# The app connects via DATABASE_URL. Native Windows app -> talk to the Dockerized
# Postgres on localhost. (In the full Docker stack this is set automatically to
# host "db" by docker-compose.yml, so you can leave it commented there.)
DATABASE_URL=postgresql+psycopg://tcuser:change-me-to-a-long-random-secret@127.0.0.1:5432/tcdb

# --- TLS / public domain (Caddy + Let's Encrypt) ----------------------------
TC_DOMAIN=studio.example.org
TC_TLS_EMAIL=admin@example.org

# --- App security / behaviour -----------------------------------------------
# MUST be 1 in production so the session cookie gets the Secure flag (HTTPS only).
COOKIE_SECURE=1
# Who may self-register (comma-separated domains).
ALLOWED_EMAIL_DOMAINS=ait.ac.at

# --- Pipeline / model secrets -----------------------------------------------
# Hugging Face token for speaker diarization (pyannote).
HF_TOKEN=
# LLM coding providers (set the ones you use). Keep these OFF public machines if
# you don't want transcript text leaving the box; Ollama keeps data local.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Test toggles (leave UNSET in production) -------------------------------
# TRANSCRIBE_FAKE=1
# LLM_FAKE=1
# KEEP_UPLOADS=1
